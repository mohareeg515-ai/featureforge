# Copy to .env for local development. Never commit real credentials.
FF_ENV=dev
FF_DATA_ROOT=./data
FF_SOURCE_KIND=synthetic
# FF_SOURCE_KIND=retail_file
# FF_RETAIL_FILE=./data/external/online_retail.csv
FF_SEED=42
FF_LOG_LEVEL=INFO
# Cloud (optional). Credentials come from the AWS IAM role / profile, never from this file.
FF_STORAGE_BACKEND=local
# FF_S3_BUCKET=featureforge-dev-data-<account-id>
# FF_S3_PREFIX=featureforge
